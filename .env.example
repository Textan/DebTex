# Debate Prep Suite — Environment Configuration Template
# NOTE: In Windows Desktop mode, credentials can be configured directly in the app
# UI and are stored securely in the Windows Credential Manager via DPAPI encryption.
# You do NOT need to fill this file unless running in headless / CI environments.

# Brave Search API Key (Optional fallback if not using Windows Credential Manager)
BRAVE_API_KEY=your_brave_search_api_key_here

# Zoom Marketplace Server-to-Server OAuth Credentials (Optional)
ZOOM_CLIENT_ID=your_zoom_client_id_here
ZOOM_CLIENT_SECRET=your_zoom_client_secret_here
